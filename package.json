{
  "name": "oryn",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:landing": "turbo dev --filter=@oryn/landing",
    "dev:dashboard": "turbo dev --filter=@oryn/dashboard",
    "dev:pay": "turbo dev --filter=@oryn/pay",
    "dev:admin": "turbo dev --filter=@oryn/admin",
    "dev:web": "turbo dev --filter=@oryn/web",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "clean": "turbo clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "@types/node": "^22",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "turbo": "^2.3.0",
    "typescript": "^5"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@clerk/elements": "^0.19.0",
    "@clerk/nextjs": "^6.9.0",
    "@tanstack/react-table": "^8.21.2",
    "basehub": "^7.0.0",
    "canvas-confetti": "^1.9.3",
    "convex": "^1.17.0",
    "culori": "^4.0.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.5.1",
    "embla-carousel-wheel-gestures": "^8.0.1",
    "framer-motion": "^11.18.0",
    "input-otp": "^1.4.1",
    "recharts": "^2.15.0"
  }
}
