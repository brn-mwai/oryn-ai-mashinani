# ===========================================
# Oryn Platform - Environment Variables
# ===========================================

# URLs
NEXT_PUBLIC_LANDING_URL=https://oryn.cc
NEXT_PUBLIC_APP_URL=https://app.oryn.cc
NEXT_PUBLIC_PAY_URL=https://pay.oryn.cc
NEXT_PUBLIC_ADMIN_URL=https://admin.oryn.cc

# ===========================================
# Authentication (Clerk)
# ===========================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
CLERK_WEBHOOK_SECRET=whsec_xxx

# Clerk URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# ===========================================
# Database (Convex)
# ===========================================
NEXT_PUBLIC_CONVEX_URL=https://xxx.convex.cloud
CONVEX_DEPLOY_KEY=xxx

# ===========================================
# AI Services
# ===========================================
# Primary: Google Gemini
GOOGLE_GENERATIVE_AI_API_KEY=xxx

# Fallback 1: Anthropic Claude
ANTHROPIC_API_KEY=xxx

# Fallback 2: Groq (fast inference)
GROQ_API_KEY=gsk_xxx

# Optional: OpenAI (uncomment if needed)
# OPENAI_API_KEY=sk-xxx

# ===========================================
# Payments - Stripe (Fiat)
# ===========================================
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ===========================================
# Payments - Circle (USDC Programmable Wallets)
# ===========================================
CIRCLE_API_KEY=xxx
CIRCLE_ENTITY_SECRET=xxx
CIRCLE_WEBHOOK_SECRET=xxx

# ===========================================
# Payments - Circle Arc (L1 Blockchain - 2026)
# ===========================================
# Arc Network: Sub-second finality, native USDC/EURC
# Partners: Visa, Mastercard, Brex, Nuvei, AWS
CIRCLE_ARC_API_KEY=xxx
CIRCLE_ARC_NETWORK=testnet
CIRCLE_ARC_WALLET_ID=xxx
CIRCLE_ARC_RPC_URL=https://rpc.arc.circle.com

# ===========================================
# Notifications - Email (Resend)
# ===========================================
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=Oryn <notifications@oryn.cc>
RESEND_REPLY_TO=support@oryn.cc
RESEND_WEBHOOK_SECRET=xxx

# ===========================================
# Notifications - SMS (Twilio)
# ===========================================
TWILIO_ACCOUNT_SID=ACxxx
TWILIO_AUTH_TOKEN=xxx
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# ===========================================
# Notifications - WhatsApp
# ===========================================
WHATSAPP_ACCESS_TOKEN=xxx
WHATSAPP_PHONE_NUMBER_ID=xxx
WHATSAPP_BUSINESS_ACCOUNT_ID=xxx
WHATSAPP_WEBHOOK_VERIFY_TOKEN=xxx
WHATSAPP_APP_SECRET=xxx

# ===========================================
# File Storage (UploadThing)
# ===========================================
UPLOADTHING_SECRET=sk_live_xxx
UPLOADTHING_APP_ID=xxx

# ===========================================
# Security (Arcjet)
# ===========================================
ARCJET_KEY=ajkey_xxx

# ===========================================
# Rate Limiting (Upstash Redis / Vercel KV)
# ===========================================
KV_REST_API_URL=https://xxx.upstash.io
KV_REST_API_TOKEN=xxx
# Or use Upstash directly:
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxx

# ===========================================
# Analytics (PostHog)
# ===========================================
NEXT_PUBLIC_POSTHOG_KEY=phc_xxx
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ===========================================
# Error Monitoring (Sentry)
# ===========================================
SENTRY_DSN=https://xxx@sentry.io/xxx
SENTRY_AUTH_TOKEN=xxx
SENTRY_ORG=xxx
SENTRY_PROJECT=xxx

# ===========================================
# Geolocation (IPinfo) - For Admin Dashboard
# ===========================================
IPINFO_TOKEN=xxx

# ===========================================
# Background Jobs (Inngest)
# ===========================================
INNGEST_EVENT_KEY=xxx
INNGEST_SIGNING_KEY=xxx

# ===========================================
# BaseHub (CMS - Landing only)
# ===========================================
BASEHUB_TOKEN=xxx
